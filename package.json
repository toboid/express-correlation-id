{
  "name": "express-correlation-id",
  "version": "3.0.1",
  "description": "Express middleware to correlate requests across http calls",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src",
    "test",
    "examples"
  ],
  "engines": {
    "node": ">=12.17.0"
  },
  "scripts": {
    "build": "tsc --project tsconfig.build.json",
    "lint": "tsc --noEmit && eslint src/**/*.ts test/*.ts examples/*.ts",
    "lint:fix": "tsc --noEmit && eslint src/**/*.ts test/*.js examples/*.js --fix",
    "test": "node --import tsx --test test/*",
    "coverage": "node --import tsx --test --experimental-test-coverage test/*",
    "watch": "node --import tsx --test --watch .",
    "prepublishOnly": "npm run build",
    "ci": "npm run lint && npm run build && npm run coverage"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/toboid/express-correlation-id.git"
  },
  "keywords": [
    "express",
    "logging",
    "correlation",
    "debug"
  ],
  "author": "toboid",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/toboid/express-correlation-id/issues"
  },
  "homepage": "https://github.com/toboid/express-correlation-id#readme",
  "dependencies": {
    "correlation-id": "^5.2.0"
  },
  "devDependencies": {
    "@types/correlation-id": "^2.1.4",
    "@types/express": "^5.0.6",
    "@types/node": "^25.0.3",
    "@typescript-eslint/eslint-plugin": "^8.51.0",
    "@typescript-eslint/parser": "^8.51.0",
    "eslint": "^9.39.2",
    "express": "^5.2.1",
    "globals": "^17.0.0",
    "supertest": "^7.1.4",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
